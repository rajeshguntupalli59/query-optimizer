# ─────────────────────────────────────────────
# QueryOptimizer — Environment Configuration
# Copy this file to .env and edit the values.
# ─────────────────────────────────────────────

# Port the frontend will be served on (default 3000)
FRONTEND_PORT=3000

# Port the backend API will be served on (default 8000)
BACKEND_PORT=8000

# License key issued at purchase. Enter this in the browser UI on first launch,
# or set it here to pre-activate (useful for automated / headless deployments).
LICENSE_KEY=

# Secret key used to encrypt saved database passwords.
# Leave blank to auto-generate on first start (recommended for quick setup).
# Set this explicitly if you need reproducible encryption across restarts.
SECRET_KEY=

# ─────────────────────────────────────────────
# AI Integration (BYOE — Bring Your Own Endpoint)
# The tool will call this endpoint for AI-powered query analysis.
# Leave blank to disable AI features.
# ─────────────────────────────────────────────

# Provider: openai | anthropic | ollama | generic
AI_PROVIDER=openai

# API endpoint URL
# OpenAI:    https://api.openai.com/v1/chat/completions
# Anthropic: https://api.anthropic.com/v1/messages
# Ollama:    http://localhost:11434/api/generate   (or http://host.docker.internal:11434/...)
# Azure:     https://<resource>.openai.azure.com/openai/deployments/<model>/chat/completions?api-version=2024-02-01
AI_ENDPOINT=

# API key / token (not needed for local Ollama)
AI_API_KEY=

# Model name to request
# OpenAI:    gpt-4o | gpt-4-turbo | gpt-3.5-turbo
# Anthropic: claude-opus-4-7 | claude-sonnet-4-6
# Ollama:    llama3 | mistral | codellama
AI_MODEL=gpt-4o

# Request timeout in seconds
AI_TIMEOUT=30
